# PostgreSQL connection. Create this database before running the schema.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/infra_alert
PGSSL=false
PORT=4000
SESSION_SECRET=replace-this-with-a-long-random-local-secret
CLIENT_ORIGIN=http://127.0.0.1:5173

# Cloudinary storage (server-side only). When all 3 values are set, new
# complaint evidence and resolution uploads are saved in Cloudinary.
# Leave all blank to keep uploads under server/uploads locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reverse geocoding providers:
#   nominatim = free public OpenStreetMap reverse geocoder, suited to low-volume
#               student/demo use. App enforces ~1 request/second and shows attribution.
#   gomaps    = GoMaps reverse geocoding; put a fresh API key below.
#   locationiq = LocationIQ reverse geocoding; set LOCATIONIQ_API_KEY below.
#   none      = save GPS coordinates without attempting to resolve an address.
# If GEOCODING_PROVIDER is blank, app uses LocationIQ when its key exists,
# then GoMaps when its key exists, otherwise Nominatim.
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
LOCATIONIQ_API_KEY=
